<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="std1" class="com.excelr.DepInjectionUsingXmlSetterInjection.Student">
        <property name="rollno" value="100"/>
        <property name="name" value="Shubh"/>
        <property name="email" value="Shubh@gmail.com"/>
        <property name="address" ref="add1"/> <!-- dependency injection -->
    </bean>

    <bean id="add1" class="com.excelr.DepInjectionUsingXmlSetterInjection.Address">
        <property name="houseno" value="#345"/>
        <property name="city" value="meerut"/>
        <property name="pincode" value="250002"/>
    </bean> <!-- this closing tag was missing -->

    <bean id="std2" class="com.excelr.DepInjectionUsingXmlSetterInjection.Student">
        <property name="rollno" value="200"/>
        <property name="name" value="Keerthi"/>
        <property name="email" value="Keerthi@gmail.com"/>
        <property name="address" ref="add2"/> <!-- dependency injection -->
    </bean>

    <bean id="add2" class="com.excelr.DepInjectionUsingXmlSetterInjection.Address">
        <property name="houseno" value="#111"/>
        <property name="city" value="Telangana"/>
        <property name="pincode" value="560006"/>
    </bean>

</beans>